# Credenciales de REST Countries v5.
# Se obtiene gratis en https://restcountries.com y NUNCA se sube al repositorio.

REST_COUNTRIES_API_KEY=

# Puerto donde escucha la API.
PUERTO=3000

# Segundos que puede esperar la fuente antes de que se dé por caída.
TIMEOUT_FUENTE_MS=8000

# Minutos que la caché conserva la lista de países antes de volver a pedirla.
CACHE_TTL_MINUTOS=60
